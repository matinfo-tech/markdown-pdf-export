{
  "name": "markdown-pdf-export",
  "version": "0.2.0",
  "description": "Export Markdown to PDF with Chromium — CLI and MCP server (works great as a Zed task)",
  "type": "module",
  "mcpName": "io.github.matinfo/markdown-pdf-export",
  "main": "export.mjs",
  "exports": {
    ".": "./export.mjs",
    "./mcp": "./mcp.mjs",
    "./schemas": "./tool-schemas.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "markdown-pdf-export": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "export.mjs",
    "mcp.mjs",
    "tool-schemas.mjs",
    "default.css",
    "lib/*.mjs",
    "vendor/"
  ],
  "scripts": {
    "check": "node --check export.mjs && node --check mcp.mjs && node --check cli.mjs && node --check tool-schemas.mjs",
    "build": "npm run check && node scripts/bundle-katex-css.mjs",
    "build:katex-css": "node scripts/bundle-katex-css.mjs",
    "prepack": "npm run build",
    "test": "node --test lib/__tests__/*.test.mjs",
    "test:export": "node ../test-fixtures/test-export.mjs",
    "test:all": "npm run test && npm run test:export",
    "install-browser": "node cli.mjs install-browser"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "date-fns": "^4.1.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "playwright-core": "^1.53.0",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "markdown",
    "pdf",
    "playwright",
    "zed",
    "mcp",
    "export",
    "converter"
  ],
  "author": "Mat <mat@matinfo.ch>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matinfo/zed-markdown-pdf"
  },
  "packageManager": "npm@11.12.1"
}
