{
  "name": "markdown-pdf-export",
  "version": "2.0.0",
  "description": "Markdown to PDF with your header, footer, page numbers and logo. Design pages in Studio, export from VS Code, Zed, Cursor, Claude or any MCP client, or the command line.",
  "type": "module",
  "mcpName": "io.github.matinfo/markdown-pdf-export",
  "main": "export.mjs",
  "exports": {
    ".": "./export.mjs",
    "./mcp": "./mcp.mjs",
    "./schemas": "./tool-schemas.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "markdown-pdf-export": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "export.mjs",
    "mcp.mjs",
    "tool-schemas.mjs",
    "default.css",
    "lib/*.mjs",
    "templates/",
    "looks/",
    "studio/",
    "schema/",
    "vendor/"
  ],
  "scripts": {
    "check": "node --check export.mjs && node --check mcp.mjs && node --check cli.mjs && node --check tool-schemas.mjs",
    "lint": "eslint .",
    "build": "npm run check && node scripts/bundle-katex-css.mjs && node scripts/build-settings-schema.mjs --check && node scripts/build-settings-reference.mjs --check",
    "build:katex-css": "node scripts/bundle-katex-css.mjs",
    "build:schema": "node scripts/build-settings-schema.mjs && node scripts/build-settings-reference.mjs",
    "build:reference": "node scripts/build-settings-reference.mjs",
    "prepack": "npm run build",
    "test": "node --test lib/__tests__/*.test.mjs",
    "test:export": "node test-fixtures/test-export.mjs",
    "test:all": "npm run test && npm run test:export",
    "install-browser": "node cli.mjs install-browser",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "ci": "npm run lint && npm run build && npm run test:all"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "playwright-core": "^1.65.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "markdown",
    "pdf",
    "markdown-to-pdf",
    "md-to-pdf",
    "cli",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "playwright",
    "chromium",
    "katex",
    "zed",
    "vscode",
    "export",
    "converter",
    "pdf-generator",
    "header-footer",
    "markdown-pdf",
    "studio",
    "claude",
    "cursor",
    "ai",
    "documentation",
    "report"
  ],
  "author": "Mat <mat@matinfo.ch>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matinfo/markdown-pdf-export.git"
  },
  "homepage": "https://matinfo.github.io/markdown-pdf-export/",
  "bugs": {
    "url": "https://github.com/matinfo/markdown-pdf-export/issues"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    }
  }
}
